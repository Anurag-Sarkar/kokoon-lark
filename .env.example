MONGODB_URI=mongodb://127.0.0.1:27017/kokoon-task

# Public URL used inside emails (invite links, task links). Optional: defaults to the
# host of the current request, which is right for localhost and for Vercel.
# APP_URL=https://tasks.yourcompany.com

# ---- Self sign-up. Anyone can create a member account at /signup by default.
# Limit it to your own email domains (comma-separated), or turn it off so accounts only come from invites.
# SIGNUP_ALLOWED_DOMAINS=kokoonlabs.com,pixxo.io
# SIGNUP_DISABLED=1

# ---- Timezone the team works in (IANA name). Server-rendered times, the "Due today" grouping and
# ---- reminder times all use it. Defaults to the server's own zone, which on most cloud boxes is UTC.
APP_TIMEZONE=Asia/Kolkata

# ---- Deadline reminders: a push + email 48 h before a task is due and again on the morning it is due.
# They run inside the app every 10 minutes in production. REMINDERS=off turns them off; REMINDERS=on
# turns them on under `next dev`. The "due today" one goes out at REMINDER_HOUR (0-23, default 9).
# To run the sweep from an outside scheduler instead, set CRON_SECRET and have it call
# POST /api/reminders/run with the header "Authorization: Bearer <CRON_SECRET>".
# REMINDER_HOUR=9
# CRON_SECRET=

# ---- Push notifications (PWA). Generate a key pair once with `npm run push:keys`, paste the two
# values here, and people can turn on "Notify me on this device" under Account. Leave empty to disable.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push services, mailto: or https:. Defaults to APP_URL.
# VAPID_SUBJECT=mailto:you@company.com

# ---- Email: pick ONE provider. With neither set, emails are printed to the server
# ---- console and invite links are shown in the admin UI to copy by hand.

# Option A — Resend (https://resend.com). Free tier: 3,000 emails/month, 100/day.
# Until you verify your own domain, Resend only delivers to the email you signed up with,
# from onboarding@resend.dev.
RESEND_API_KEY=
MAIL_FROM="Kokoon Task <onboarding@resend.dev>"

# Option B — any SMTP server. Example: Gmail with an App Password (not your normal password):
# SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=you@gmail.com  SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
